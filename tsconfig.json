{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["DOM", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "mobile/**/*.ts",
    "mobile/**/*.tsx",
    "lib/**/*.ts",
    "components/**/*.tsx",
    "server/**/*.ts",
    "tests/server/**/*.ts"
  ]
}
